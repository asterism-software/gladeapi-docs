{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Glade API",
  "theme": "almond",
  "colors": {
    "primary": "#447B39",
    "light": "#8AB54C",
    "dark": "#336B36"
  },
  "logo": {
    "light": "/logo/glade-light.png",
    "dark": "/logo/glade-dark.png",
    "href": "https://gladeapi.com"
  },
  "favicon": "/glade-icon.png",
  "fonts": {
    "family": "Inter"
  },
  "background": {
    "color": {
      "light": "#FCFDF8",
      "dark": "#102D1C"
    }
  },
  "api": {
    "openapi": "https://gladeapi.com/api/v1/openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/interfaces",
              "concepts/marketplaces",
              "concepts/data-freshness",
              "concepts/units-and-billing",
              "concepts/rate-limits"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/price-monitoring",
              "guides/product-research",
              "guides/review-intelligence",
              "guides/ai-agents"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Products",
            "pages": [
              "api-reference/product",
              "api-reference/product-variants",
              "api-reference/product-offers",
              "api-reference/product-reviews",
              "api-reference/stock-estimates",
              "api-reference/sales-estimates",
              "api-reference/gtin-from-asin",
              "api-reference/asin-from-gtin"
            ]
          },
          {
            "group": "Search & Discovery",
            "pages": [
              "api-reference/search",
              "api-reference/autocomplete",
              "api-reference/deals",
              "api-reference/bestsellers",
              "api-reference/bestseller-categories"
            ]
          },
          {
            "group": "Sellers & Categories",
            "pages": [
              "api-reference/seller",
              "api-reference/author",
              "api-reference/categories",
              "api-reference/category"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Status",
        "href": "https://gladeapi.com/status"
      },
      {
        "label": "Support",
        "href": "https://gladeapi.com/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://gladeapi.com/auth/login?next=/dashboard"
    }
  },
  "footer": {
    "socials": {
      "website": "https://gladeapi.com"
    }
  }
}
