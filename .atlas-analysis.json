  "keyFeatures": [
    "Canopy-compatible REST API for Amazon product data",
    "GraphQL interface with the same operations and quota semantics",
    "MCP (Model Context Protocol) endpoint for AI agents and LLM tool-use",
    "Coverage across 13 Amazon marketplaces (US, UK, CA, DE, FR, IT, ES, AU, IN, MX, BR, JP, PL)",
    "Product details, pricing, images, ratings, and feature bullets",
    "Product reviews with filtering by rating, verified purchase, and keyword search",
    "Third-party seller offers with delivery and condition details",
    "Sales and stock estimates for inventory and market research",
    "Search with filters, sorting, price range, and pagination",
    "Deals feed with lightning deal detection and discount metadata",
    "Best sellers ranked by category",
    "ASIN ↔ GTIN (barcode) conversion utilities",
    "Usage-based pricing — errors are never charged",
    "Reveal-once API keys scoped to your workspace"
  ],
  "publicApiSurface": [
